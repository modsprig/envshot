<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EnvShot/EnvShot.csproj" />
  </ItemGroup>
  <!-- Native library resolution: build the Rust cdylib and copy it into the
       test output (ProjectReference transitivity does not carry natives). -->
  <Target Name="BuildRustNative" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build --release -p envshot-ffi" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../target/release/envshot_ffi.dll" DestinationFiles="$(OutputPath)envshot_ffi.dll" Condition="'$(OS)' == 'Windows_NT'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../target/release/libenvshot_ffi.so" DestinationFiles="$(OutputPath)libenvshot_ffi.so" Condition="'$(OS)' != 'Windows_NT' And Exists('$(MSBuildThisFileDirectory)../../target/release/libenvshot_ffi.so')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../target/release/libenvshot_ffi.dylib" DestinationFiles="$(OutputPath)libenvshot_ffi.dylib" Condition="'$(OS)' != 'Windows_NT' And Exists('$(MSBuildThisFileDirectory)../../target/release/libenvshot_ffi.dylib')" />
  </Target>
  <!-- The native library is copied by the EnvShot project's BuildRustNative
       target (ProjectReference transitivity covers the dll in output). -->
</Project>
